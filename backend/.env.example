RACK_ENV=production
APP_HOST=0.0.0.0
APP_PORT=4567
PORT=4567
FRONTEND_ROOT=..

# Comma-separated allowed origins for cross-origin API calls.
# For same-origin deployment this can remain empty.
# For cross-origin deployments, set explicit origins only (no wildcard in production).
CORS_ORIGINS=https://employee-task-assignment-app-885400484338.asia-south2.run.app

# Prefer DATABASE_URL for production and include sslmode=require for managed PostgreSQL.
# Runtime example:
# DATABASE_URL=postgres://app_rw:CHANGE_ME_STRONG_PASSWORD@db-host:5432/task_assignment?sslmode=require
DATABASE_URL=
RUNTIME_DATABASE_URL=
PRODUCTION_DATABASE_URL=
STAGING_DATABASE_URL=

# Public HTTPS endpoints used by rollout/promotion verification.
STAGING_BASE_URL=https://staging.example.com
PRODUCTION_BASE_URL=https://app.example.com

# Fallback discrete DB params if DATABASE_URL is not used.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=task_assignment
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Keep session lifetime short in production.
SESSION_TTL_HOURS=12
# Fail startup when required DB tables are missing (recommended for production).
DB_STARTUP_CHECKS=1

MANAGER_EMAIL=manager@company.com
MANAGER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MANAGER_NAME=Manager
MANAGER_PHONE=

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
WHATSAPP_MAX_RETRIES=3
